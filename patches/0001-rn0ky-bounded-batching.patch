+def max_candidates_per_call(agent_cfg: Any) -> Optional[int]:
+    """The station's declared per-call candidate bound, or None for one call (rn0ky).
+
+    Opt-in by declaration, deliberately: batching changes what a station asks the model for, so it is
+    the station's decision (agent.yaml `output.max_candidates_per_call`), not a global surprise for the
+    twenty other stations. A malformed value is refused loudly rather than silently ignored - a bound
+    nobody applied is how a 47-candidate batch truncated in the first place.
+    """
+    if not isinstance(agent_cfg, dict):
+        return None
+    output = agent_cfg.get("output")
+    if not isinstance(output, dict):
+        return None
+    raw = output.get("max_candidates_per_call")
+    if raw is None:
+        return None
+    try:
+        value = int(raw)
+    except (TypeError, ValueError):
+        raise StationError(
+            f"agent.yaml output.max_candidates_per_call must be an integer, got {raw!r}")
+    if value < 1:
+        raise StationError(
+            f"agent.yaml output.max_candidates_per_call must be >= 1, got {value}")
+    return value
+
+
+def parse_station_report(raw_output: str, *, agent_dir: Path, agent_cfg: Any,
+                         target_dir: Optional[Path], run_dir: Path,
+                         tag: str = "") -> Tuple[Optional[Dict[str, Any]], Optional[str]]:
+    """Parse, normalise and schema-validate ONE engine output. `(report, None)` or `(None, reason)`.
+
+    Extracted from the single-call path so a BATCHED run (rn0ky) applies exactly the same contract to
+    every batch: the same field normalisation, the same schema, the same artifacts. `tag` suffixes the
+    artifact names (`.batch3`) so a batched run keeps each batch's rejected report instead of the last
+    one overwriting the others.
+
+    The reason string is the same text the single-call path has always produced, so a downstream reader
+    (and the repair-retry hint) sees no change for single-call stations.
+    """
+    report = extract_json_from_output(raw_output)
+    if report is not None and not isinstance(report.get("findings"), list):
+        # Every report contract requires a findings list. An object without one (a fragment of
+        # truncated output, an echoed tool call) is not a verdict; reading its missing findings as
+        # [] was a clean PASS/0 nobody earned.
+        report = None
+    if report is None:
+        return None, "Could not parse a JSON report (with a findings list) from model output"
+    # Known field-name synonyms are mapped first (fleet-9wyi): `"id"` for `rule_id` is a usable
+    # report, not a missing one. Every mapping is printed and recorded.
+    normalised = normalize_agent_report(agent_dir, agent_cfg, report)
+    if normalised:
+        print(f"Note: normalised {len(normalised)} field name(s)/value(s) in the model "
+              f"report (first: {normalised[0]}); see normalised_fields{tag}.json.")
+        _write_run_artifact(run_dir / f"normalised_fields{tag}.json", json.dumps(normalised, indent=2))
+    # The output contract is the deterministic half of the agent (SF-07): a report that violates it
+    # is treated exactly like unparseable output - the store never sees it, so no finding transitions
+    # on half-formed data.
+    schema_errors = validate_agent_report(agent_dir, agent_cfg, report, target_dir=target_dir)
+    if schema_errors:
+        rejected = report.get("findings") if isinstance(report.get("findings"), list) else []
+        # Say what was lost and where it is, so a rejection never reads as an empty response
+        # (fleet-9wyi): the full violation list and the parsed report are kept.
+        _write_run_artifact(run_dir / f"schema_errors{tag}.json", json.dumps(schema_errors, indent=2))
+        _write_run_artifact(run_dir / f"rejected_report{tag}.json", json.dumps(report, indent=2))
+        return None, (f"Model output violates the declared report schema "
+                      f"({len(schema_errors)} violation(s); first: {schema_errors[0]}); "
+                      f"{len(rejected)} finding(s) were in the rejected report "
+                      f"(kept in {run_dir / f'rejected_report{tag}.json'}, violations in "
+                      f"schema_errors{tag}.json)")
+    return report, None
+
+
+def name_parse_failure(raw_output: str, reason: str, *, run_dir: Path, agent_name: str,
+                       batch_index: Optional[int] = None, batch_count: Optional[int] = None,
+                       expected_ids: Sequence[str] = ()) -> str:
+    """Turn an unusable output into a NAMED failure: truncated vs no-JSON, with the evidence kept.
+
+    rn0ky: a completion cut by an output bound used to reach the operator as "no verdict", which reads
+    as a model that ignored the contract and sends nobody looking for a token limit. The classification
+    is structural (ends inside a string, or unclosed braces) and is written to
+    `output_classification.json` in the run directory either way, so the two failures stay tellable
+    apart after the fact.
+    """
+    kind, evidence = classify_unparseable(raw_output)
+    record = {"kind": kind, "reason": reason}
+    if batch_index is not None and batch_count is not None:
+        record["batch"] = batch_index + 1
+        record["batches"] = batch_count
+    record.update(evidence)
+    _write_run_artifact(run_dir / "output_classification.json", json.dumps(record, indent=2))
+    if kind == "truncated":
+        named = describe_truncation(
+            evidence,
+            batch_index=batch_index if batch_index is not None else 0,
+            batch_count=batch_count if batch_count is not None else 1,
+            expected_ids=expected_ids)
+        return f"{agent_name}: model output was TRUNCATED - {named} (evidence in output_classification.json)"
+    return reason
+

{
  "manifest_version": 3,
  "name": "Chrome Agent Platform",
  "version": "0.1.0",
  "description": "Chrome as the agent platform: an agent hub that orchestrates the web via WebMCP, with sites-as-sub-agents, OPFS memory, alarms, and co-do WASM tools.",
  "permissions": [
    "alarms",
    "storage",
    "sidePanel",
    "tabs",
    "notifications"
  ],
  "host_permissions": ["<all_urls>"],
  "chrome_url_overrides": {
    "newtab": "ntp/ntp.html"
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "action": {
    "default_title": "Open Agent Hub"
  },
  "options_page": "memory/explorer.html"
}

{
  "manifest_version": 3,
  "name": "Chrome Agent Platform",
  "version": "0.2.0",
  "description": "Chrome as the agent platform: a multi-agent hub that orchestrates the web via WebMCP, with sites-as-sub-agents, origin-keyed OPFS memory, alarms, and usage accounting.",
  "permissions": [
    "alarms",
    "storage",
    "sidePanel",
    "tabs",
    "scripting",
    "notifications"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "chrome_url_overrides": {
    "newtab": "ntp/ntp.html"
  },
  "background": {
    "service_worker": "dist/background/service-worker.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "action": {
    "default_title": "Open Agent Hub"
  },
  "options_page": "options/options.html",
  "icons": {
    "128": "icon128.png"
  }
}
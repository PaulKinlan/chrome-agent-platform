{
  "name": "chrome-agent-platform",
  "version": "0.2.430",
  "private": true,
  "type": "module",
  "description": "Chrome as the agent platform — agent hub, WebMCP tool directory, sites-as-sub-agents, OPFS memory, alarms.",
  "scripts": {
    "build": "node build.mjs --target=developer",
    "build:debug": "node build.mjs --target=developer",
    "build:production": "node build.mjs --target=store",
    "build:regen-tools": "node build.mjs --target=store --regen-tools",
    "sync:gallery": "node scripts/sync-gallery.mjs",
    "check:gallery": "node scripts/sync-gallery.mjs --check",
    "check:vocabulary": "node scripts/check-vocabulary.mjs",
    "watch": "node build.mjs --watch",
    "test": "deno test -A tests/",
    "test:chrome": "deno run -A scripts/chrome-journeys.ts",
    "test:agent-access": "deno run -A scripts/agent-access-journeys.ts",
    "test:components": "deno run -A scripts/component-gallery-smoke.ts",
    "test:directory": "deno run -A scripts/agent-directory-ui.ts",
    "test:security": "bash scripts/security-suite-supervisor.sh",
    "test:a11y": "deno run -A scripts/a11y-audit.ts",
    "test:perf": "deno run -A scripts/perf-leak-trace.ts",
    "test:capabilities": "deno run -A scripts/capability-lifecycle.ts",
    "test:all": "node scripts/check-tasks.mjs && npm run check:vocabulary && npm test && npm run test:security && npm run test:chrome",
    "version:patch": "node scripts/bump-version.mjs patch",
    "version:minor": "node scripts/bump-version.mjs minor",
    "version:major": "node scripts/bump-version.mjs major",
    "test:tools": "deno test -A tests/tools-*.test.ts",
    "test:ui": "deno run -A scripts/ui-integration.ts",
    "test:opfs": "deno run -A scripts/opfs-real-browser.ts",
    "test:webmcp": "deno run -A scripts/webmcp-acceptance.ts",
    "test:sidebar": "deno run -A scripts/sidebar-parity.ts",
    "sync:changelog": "node scripts/sync-changelog.mjs",
    "check:changelog": "node scripts/sync-changelog.mjs --check",
    "package": "node scripts/package-extension.mjs --target=store",
    "package:store": "node scripts/package-extension.mjs --target=store",
    "check:changelog-order": "node scripts/check-changelog.mjs",
    "check:tasks": "node scripts/check-tasks.mjs",
    "test:data-clear": "deno run -A scripts/data-memory-clear.ts",
    "test:role-preview": "deno run -A scripts/agent-role-preview.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.45",
    "@ai-sdk/google": "^4.0.44",
    "@ai-sdk/openai": "^4.0.42",
    "@ai-sdk/openai-compatible": "^3.0.30",
    "agent-do": "^0.7.0",
    "ai": "^7.0.66",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "acorn": "^8.18.0",
    "esbuild": "^0.25.0",
    "fake-indexeddb": "^6.2.5"
  }
}

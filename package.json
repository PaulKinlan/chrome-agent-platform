{
  "name": "chrome-agent-platform",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Chrome as the agent platform \u2014 agent hub, WebMCP tool directory, sites-as-sub-agents, OPFS memory, alarms.",
  "scripts": {
    "build": "node build.mjs",
    "sync:gallery": "node scripts/sync-gallery.mjs",
    "check:gallery": "node scripts/sync-gallery.mjs --check",
    "watch": "node build.mjs --watch",
    "test": "deno test --allow-read tests/",
    "test:chrome": "deno run -A scripts/chrome-journeys.ts",
    "test:components": "deno run -A scripts/component-gallery-smoke.ts",
    "test:security": "deno run -A scripts/security-suite.ts",
    "test:all": "deno test --allow-read tests/ && deno run -A scripts/security-suite.ts && deno run -A scripts/chrome-journeys.ts"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.44",
    "@ai-sdk/openai": "^4.0.42",
    "@ai-sdk/openai-compatible": "^3.0.30",
    "agent-do": "^0.7.0",
    "ai": "^7.0.66",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
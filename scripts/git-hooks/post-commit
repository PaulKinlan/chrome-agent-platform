#!/bin/sh
# Reference post-commit hook (xk2u, 2026-09-05). Install with:
#   cp scripts/git-hooks/post-commit .git/hooks/post-commit && chmod +x .git/hooks/post-commit
#
# Auto-bump the patch version after each commit (guard against the
# amend loop). The changelog entry uses the note the author states explicitly —
# see 8nec below; the commit subject is never a note source.
#
# xk2u hardening: a commit whose note sanitizes to nothing user-sayable
# (merge subjects, bare branch names) must NOT consume a version and must NEVER
# write a placeholder entry — that placeholder path is how 93 fake
# "Maintenance and fixes." entries shipped on 2026-09-05.
#
# 8nec: the note is NEVER inferred from the subject. The author states it explicitly:
#   Release-note: <what the user gets>    (a line in the commit message body), or
#   CAP_USER_NOTE=<what the user gets>    (in the environment)
# A bookkeeping subject can no longer consume a version, and a user-facing subject
# that happens to name a component (harness, bridge) is no longer silently declined —
# it simply does not bump until the author says what the user gets. The bump is also
# once per branch: the script skips when the working version no longer matches
# origin/main's, so a second commit on the branch is free. Explicit bump when ready:
#   node scripts/bump-version.mjs patch --user-note "<what the user gets>"
if [ -n "$CAP_SEMVER_AMEND" ]; then exit 0; fi
export CAP_SEMVER_AMEND=1
MSG="$(git log -1 --format=%s)"
BODY="$(git log -1 --format=%B)"
NOTE="$(printf '%s\n' "$BODY" | sed -n 's/^[Rr]elease-note:[[:space:]]*//p' | head -n 1)"
if [ -z "$NOTE" ]; then NOTE="${CAP_USER_NOTE:-}"; fi
if [ -n "$NOTE" ]; then
  node scripts/bump-version.mjs patch --hook --message "$MSG" --user-note "$NOTE"
else
  node scripts/bump-version.mjs patch --hook --message "$MSG"
fi
# keep the bundled gallery/changelog in lockstep with the just-bumped tree
node scripts/sync-gallery.mjs >/dev/null 2>&1
git add package.json package-lock.json extension/manifest.json CHANGELOG.md extension/CHANGELOG.md 2>/dev/null
# amend only when the bump actually staged something (skip-if-no-note may have
# changed nothing — bookkeeping commits must not be rewritten)
git diff --cached --quiet || git commit -q --amend --no-edit

# 1mz2: extension/dist/dist.complete binds HEAD + every indexed source byte, and
# the amend above already moved HEAD — so the built extension is stale from this
# commit on, and the next gate would red on a marker instead of naming the cause.
# Say it once, with the fix. A NOTE, never a gate: the script always exits 0 and
# prints nothing when the build is current, and a missing node never blocks.
# 1mz2: this hook is MACHINE-LOCAL (.git/hooks), while the note script is
# TRACKED and may not exist on the branch being committed (a worktree off an
# older main, or before the change lands). Never call it blind: a missing
# script must be silence, not a Node crash trace in every lane's commit log.
if command -v node >/dev/null 2>&1 && [ -f scripts/dist-staleness-note.mjs ]; then
  node scripts/dist-staleness-note.mjs 2>&1 || true
fi

# Beads: auto-push Dolt data to remote after each commit. Runs from the
# committing checkout's root (where git runs every hook); bd resolves the shared
# database from a linked worktree by itself. Never locate the repo via $0 — that
# is the primary checkout's hook file from every worktree (chrome-agent-platform-ufrr).
(
  bd dolt push 2>/dev/null
) &

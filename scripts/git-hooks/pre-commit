#!/bin/sh
# Reference pre-commit hook for the beads tracker export (.beads/issues.jsonl).
# Install with (from the primary checkout — hooks live only in the common
# .git/hooks, so one install serves every linked worktree):
#   cp scripts/git-hooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
#
# chrome-agent-platform-ufrr: git runs a hook with the working directory already
# at the root of the checkout being committed, but $0 is ALWAYS the primary
# checkout's hook file. The previous hook did `cd "$(dirname "$0")/../.."`,
# landed in the primary, wrote the export there (dirtying the shared checkout
# for every session) and, with GIT_INDEX_FILE still bound to the worktree,
# staged the primary's on-disk file into the worktree's index while the
# worktree's own copy stayed stale. Work from `.`; never locate the repo via $0.
#
# chrome-agent-platform-xcffx (the tracker-export contract, coord 2026-11-12):
# a lane commit carries ONLY what its author staged. This hook NEVER regenerates
# or stages the export on its own: force-staging it into every ordinary commit
# baked tracker churn into authored commits (three review rounds spent on a file
# the author did not intend to change; 6i9df FAILed review on that churn alone),
# and the baked-in diff is what a rebase then conflicts on at patch-apply, one
# step before any hook can run. The export is refreshed once per landing by the
# merger (chrome-agent-platform-jztvo). What remains here, in every mode:
#  1. A GIT CONFLICT MARKER never rides a commit, on disk or staged (iaccg/g1a09).
#  2. A REPLAY (rebase/merge/cherry-pick/revert) passes through untouched, so a
#     replayed commit keeps the content it was authored with.
#  3. An author who STAGES an export change deliberately gets it validated: the
#     staged candidate must not silently drop a committed or on-disk issue ID
#     (vf69), and the hook recommends its own labelled commit.
[ -d .beads ] || exit 0

# xcffx: a GIT CONFLICT MARKER never rides in a commit, whatever path staged it.
# The export is generated, so a marker in it can only mean a conflicted merge was
# resolved without regenerating — and committing it hands every other lane a beads
# export that parses as garbage (iaccg: a FAIL caused by exactly that). Checked
# first and in every mode: a replayed or author-staged conflicted file must be
# refused before anything else can ride it into history.
has_markers() {
  grep -Eq '^(<<<<<<< |>>>>>>> |=======$)' "$1" 2>/dev/null
}
refuse_markers() {
  echo "[pre-commit] REFUSED: $1 contains GIT CONFLICT MARKERS (<<<<<<< / ======= / >>>>>>>)." >&2
  echo "[pre-commit] A conflict-marked tracker export is not a merge resolution: it is a corrupt file that" >&2
  echo "[pre-commit] every other lane's bd will read. Regenerate it (bd export --all > .beads/issues.jsonl)," >&2
  echo "[pre-commit] then STAGE the regenerated file (git add .beads/issues.jsonl) — the commit carries the" >&2
  echo "[pre-commit] INDEX, not the working tree, and a resolved copy that is only on disk is not the one committed." >&2
  exit 1
}
[ -f .beads/issues.jsonl ] && has_markers .beads/issues.jsonl && refuse_markers ".beads/issues.jsonl on disk"

# g1a09: the commit carries the INDEX copy, not the working-tree copy, so checking the
# file on disk is not enough. The bypass this closes was mine: the replay branch below
# exits before re-staging, so a conflict-marked export staged during a rebase resolution
# (git requires the resolved path to be staged) rode into the replayed commit while the
# regenerated on-disk file read clean — and this hook's own remedy message told the
# resolver to regenerate, never to stage. Checked BEFORE the replay exit and
# unconditionally, because the pre-replay hook only healed this by accident (its
# `git add` overwrote the marked index copy, which is the churn this bead removes).
index_has_markers() {
  git cat-file -e ":.beads/issues.jsonl" 2>/dev/null || return 1
  git show ":.beads/issues.jsonl" 2>/dev/null | has_markers -
}
index_has_markers && refuse_markers "the STAGED copy of .beads/issues.jsonl (the git index — what this commit would carry)"

# xcffx: during a REPLAY git owns the commit's content, so the hook must not
# inspect beyond the marker guards. A rebase conflict on .beads/issues.jsonl
# happens at patch-apply, one step before any hook runs (measured rebasing z7i3m
# onto main: 3 commits -> 3 conflicts on that file, none produced by this hook) —
# and with the export no longer baked into lane commits at all (the contract
# above), that conflict class disappears as branches stop carrying the churn.
in_replay() {
  for state in rebase-merge rebase-apply MERGE_HEAD CHERRY_PICK_HEAD REVERT_HEAD; do
    p=$(git rev-parse --git-path "$state" 2>/dev/null) || continue
    [ -n "$p" ] && [ -e "$p" ] && return 0
  done
  return 1
}
if in_replay; then
  # Silent by design: a rebase prints this once per replayed commit, and the
  # explanation belongs in the hook, not in 28 identical stderr lines.
  exit 0
fi

# xcffx: nothing below regenerates or stages anything. The export rides a commit
# only when the author staged it deliberately; otherwise the commit contains
# exactly the files the author changed — nothing else.
git diff --cached --quiet -- .beads/issues.jsonl && exit 0

# 23mbo: a staged DELETION is a change too, but there is no staged content to
# validate — an unguarded `git show :path` fails raw ('fatal: ambiguous
# argument') and feeds the checker an EMPTY temp file, which then blames the
# canonical DB ('no issue IDs') instead of the author's staged deletion.
# Refuse by name instead. Fail-closed: a deliberate removal of the tracker
# export is a decision, not a keystroke, so it goes through --no-verify with
# the decision named, like the conflict-marker path above.
if ! git diff --cached --diff-filter=D --quiet -- .beads/issues.jsonl; then
  echo "[pre-commit] REFUSED: .beads/issues.jsonl is staged as DELETED —" >&2
  echo "[pre-commit] restore it (git checkout HEAD -- .beads/issues.jsonl) or land the deletion" >&2
  echo "[pre-commit] deliberately with --no-verify and a named decision bead (23mbo)." >&2
  exit 1
fi

# The author staged an export change. Validate the STAGED candidate — the commit
# carries the index, not the working tree (g1a09) — so a staged export cannot
# silently drop a committed or on-disk issue ID (vf69). Older worktrees without
# the checker (or without Node) commit the staged export unvalidated rather than
# being blocked: nothing is ever overwritten here, so there is nothing to erase.
if [ ! -f scripts/check-beads-export-divergence.mjs ] || ! command -v node >/dev/null 2>&1; then
  echo "[pre-commit] divergence check unavailable — committing the staged export UNVALIDATED" >&2
  exit 0
fi
tmp=".beads/.issues.jsonl.$$.tmp"
trap 'rm -f "$tmp"' EXIT
git show ":.beads/issues.jsonl" > "$tmp"
node scripts/check-beads-export-divergence.mjs --candidate "$tmp" || exit 1
# The labelled-commit shape is a reviewer contract (xcffx acceptance): an export
# riding alongside authored files makes the diff reviewable only by trusting it.
if [ "$(git diff --cached --name-only | grep -vc '^\.beads/issues\.jsonl$')" -gt 0 ]; then
  echo "[pre-commit] NOTE: .beads/issues.jsonl rides this commit alongside authored files." >&2
  echo "[pre-commit] Prefer its own labelled commit (chore(beads): tracker export) so a reviewer" >&2
  echo "[pre-commit] can ignore a known machine-generated path (xcffx / chrome-agent-platform-jztvo)." >&2
fi
exit 0

#!/bin/sh
# Reference pre-commit hook: refresh .beads/issues.jsonl (the passive tracker
# export) so every commit carries the tracker state it was made against.
# Install with (from the primary checkout — hooks live only in the common
# .git/hooks, so one install serves every linked worktree):
#   cp scripts/git-hooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
#
# chrome-agent-platform-ufrr: git runs a hook with the working directory already
# at the root of the checkout being committed, but $0 is ALWAYS the primary
# checkout's hook file. The previous hook did `cd "$(dirname "$0")/../.."`,
# landed in the primary, wrote the export there (dirtying the shared checkout
# for every session) and, with GIT_INDEX_FILE still bound to the worktree,
# staged the primary's on-disk file into the worktree's index while the
# worktree's own copy stayed stale. Work from `.`; never locate the repo via $0.
#
# chrome-agent-platform-xcffx: the hook does NOT stage the export while git is
# replaying commits (rebase/merge/cherry-pick/revert — see in_replay below), so a
# replayed commit keeps the content it was authored with, and it REFUSES a
# conflict-marked export in every mode. Ordinary commits still refresh and stage it:
# a passive export that never rides a commit goes stale and the divergence check then
# has nothing current to compare.
#
# The export lands in a temp file first: `bd export > file` truncates the file
# before bd starts, so a failing bd would have staged an EMPTY export. A failed
# or empty export leaves the committed file alone and says so. A successful
# export that drops a committed issue ID blocks the commit for manual review.
[ -d .beads ] || exit 0

# xcffx: a GIT CONFLICT MARKER never rides in a commit, whatever path staged it.
# The export is generated, so a marker in it can only mean a conflicted merge was
# resolved without regenerating — and committing it hands every other lane a beads
# export that parses as garbage (iaccg: a FAIL caused by exactly that). Checked
# BEFORE any refresh and in every mode, because the modes that skip the refresh are
# the ones most likely to commit a stale, conflicted file.
has_markers() {
  grep -Eq '^(<<<<<<< |>>>>>>> |=======$)' "$1" 2>/dev/null
}
refuse_markers() {
  echo "[pre-commit] REFUSED: $1 contains GIT CONFLICT MARKERS (<<<<<<< / ======= / >>>>>>>)." >&2
  echo "[pre-commit] A conflict-marked tracker export is not a merge resolution: it is a corrupt file that" >&2
  echo "[pre-commit] every other lane's bd will read. Regenerate it (bd export --all > .beads/issues.jsonl)," >&2
  echo "[pre-commit] then STAGE the regenerated file (git add .beads/issues.jsonl) — the commit carries the" >&2
  echo "[pre-commit] INDEX, not the working tree, and a resolved copy that is only on disk is not the one committed." >&2
  exit 1
}
[ -f .beads/issues.jsonl ] && has_markers .beads/issues.jsonl && refuse_markers ".beads/issues.jsonl on disk"

# g1a09: the commit carries the INDEX copy, not the working-tree copy, so checking the
# file on disk is not enough. The bypass this closes was mine: the replay branch below
# exits before re-staging, so a conflict-marked export staged during a rebase resolution
# (git requires the resolved path to be staged) rode into the replayed commit while the
# regenerated on-disk file read clean — and this hook's own remedy message told the
# resolver to regenerate, never to stage. Checked BEFORE the replay exit and
# unconditionally, because the pre-replay hook only healed this by accident (its
# `git add` overwrote the marked index copy, which is the churn this bead removes).
index_has_markers() {
  git cat-file -e ":.beads/issues.jsonl" 2>/dev/null || return 1
  git show ":.beads/issues.jsonl" 2>/dev/null | has_markers -
}
index_has_markers && refuse_markers "the STAGED copy of .beads/issues.jsonl (the git index — what this commit would carry)"

# xcffx: during a REPLAY git owns the commit's content, so the hook must not rewrite it.
# The export describes the DB as it is NOW; staging it while git replays an old commit
# stamps TODAY's tracker state into a HISTORICAL commit — the replayed commit then says
# it was made against a tracker state that did not exist yet, and every replay adds
# export churn the author never authored. Skipping the refresh during replay does NOT
# stop a rebase conflicting on this file: that conflict happens one step earlier, when
# git applies the export diff baked into the ORIGINAL commit (measured rebasing z7i3m
# onto main: 3 commits -> 3 .beads/issues.jsonl conflicts, all at patch-apply, none of
# them produced by this hook). Removing the baked-in churn is a change to what a lane
# commit CONTAINS, which is a tracker-contract decision (xcffx residual), not a hook fix.
in_replay() {
  for state in rebase-merge rebase-apply MERGE_HEAD CHERRY_PICK_HEAD REVERT_HEAD; do
    p=$(git rev-parse --git-path "$state" 2>/dev/null) || continue
    [ -n "$p" ] && [ -e "$p" ] && return 0
  done
  return 1
}
if in_replay; then
  # Silent by design: a rebase prints this once per replayed commit, and the
  # explanation belongs in the hook, not in 28 identical stderr lines.
  exit 0
fi

# The hook is shared across worktrees, including older branches that predate
# this checker. Without it (or Node), preserve the old export rather than
# silently replacing it or blocking every commit on that branch.
if [ ! -f scripts/check-beads-export-divergence.mjs ] || ! command -v node >/dev/null 2>&1; then
  echo "[pre-commit] divergence check unavailable — committing without refreshing .beads/issues.jsonl" >&2
  exit 0
fi
tmp=".beads/.issues.jsonl.$$.tmp"
err="$tmp.err"
trap 'rm -f "$tmp" "$err"' EXIT
if bd export --all > "$tmp" 2> "$err" && [ -s "$tmp" ]; then
  has_markers "$tmp" && refuse_markers "the freshly exported .beads/issues.jsonl"
  # A passive export can be stale, but overwriting it must not silently erase
  # the last visible copy of an issue missing from the canonical DB (vf69).
  node scripts/check-beads-export-divergence.mjs --candidate "$tmp" || exit 1
  mv -f "$tmp" .beads/issues.jsonl
  git add .beads/issues.jsonl
else
  echo "[pre-commit] bd export failed or empty — committing without refreshing .beads/issues.jsonl" >&2
  [ -s "$err" ] && cat "$err" >&2
fi
exit 0
